<?xml version="1.0"?>

<launch>
  <arg name="world_name" default="$(find ackermann_vehicle_gazebo)/worlds/sim_world.world"/>
  <arg name="cmd_timeout" default="0.5"/>
  <arg name="gui" default="true"/>
  <arg name="paused" default="false"/>
  <arg name="headless" default="false"/>
  <arg name="debug" default="false"/>
  <arg name="use_sim_time" default="true"/>

  <arg name="x" default="-1.0"/>
  <arg name="y" default="0.0"/>
  <arg name="z" default="1.2"/>
  <arg name="roll" default="0.0"/>
  <arg name="pitch" default="0.0"/>
  <arg name="yaw" default="1.57"/>

  <param name="use_sim_time" value="$(arg use_sim_time)"/>

  <include file="$(find ackermann_vehicle_description)/launch/ackermann_vehicle_hokuyo_noetic.launch"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world_name)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="headless" value="$(arg headless)"/>
    <arg name="debug" value="$(arg debug)"/>
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
  </include>

  <rosparam file="$(find ackermann_vehicle_gazebo)/config/em_3905_joint_ctrlr_params.yaml" command="load"/>

  <node name="spawn_vehicle" pkg="gazebo_ros" type="spawn_model" output="screen"
        args="-urdf -param robot_description -model ackermann_vehicle
              -x $(arg x) -y $(arg y) -z $(arg z)
              -R $(arg roll) -P $(arg pitch) -Y $(arg yaw)"/>

  <node name="controller_bootstrap" pkg="ackermann_vehicle_gazebo"
        type="controller_bootstrap.py" output="screen">
    <param name="controller_manager_ns" value="/controller_manager"/>
    <param name="clock_wait_timeout" value="20.0"/>
    <param name="start_timeout" value="30.0"/>
    <param name="retry_period" value="0.5"/>
    <rosparam param="controllers">
      - joint_state_ctrlr
      - left_steering_ctrlr
      - right_steering_ctrlr
      - left_front_axle_ctrlr
      - right_front_axle_ctrlr
      - left_rear_axle_ctrlr
      - right_rear_axle_ctrlr
      - left_front_shock_ctrlr
      - right_front_shock_ctrlr
      - left_rear_shock_ctrlr
      - right_rear_shock_ctrlr
    </rosparam>
  </node>

  <node name="ackermann_controller" pkg="ackermann_vehicle_gazebo"
        type="ackermann_controller" output="screen">
    <param name="cmd_timeout" value="$(arg cmd_timeout)"/>
    <rosparam file="$(find ackermann_vehicle_gazebo)/config/em_3905_ackermann_ctrlr_params.yaml" command="load"/>
  </node>
</launch>
