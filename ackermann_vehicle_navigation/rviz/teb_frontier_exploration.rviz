Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Map1
        - /RobotModel1
        - /TF1
        - /Frontiers1
      Splitter Ratio: 0.45
    Tree Height: 760
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.45
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Plane: XY
      Plane Cell Count: 60
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/Map
      Enabled: true
      Name: Map
      Topic: /map
      Value: true
    - Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: true
      Name: RobotModel
      Robot Description: robot_description
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.5
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: true
    - Alpha: 0.85
      Class: rviz/LaserScan
      Color: 255; 40; 40
      Enabled: true
      Name: LaserScan
      Queue Size: 10
      Size (Pixels): 6
      Size (m): 0.06
      Style: Flat Squares
      Topic: /ackermann_vehicle/scan
      Use Fixed Frame: true
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /explore/frontiers
      Name: Frontiers
      Namespaces:
        {}
      Queue Size: 20
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 210; 0
      Enabled: true
      Line Style: Billboards
      Line Width: 0.1
      Name: OdomPath
      Queue Size: 10
      Topic: /odom_visualization/path
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 0; 180; 255
      Enabled: true
      Line Style: Billboards
      Line Width: 0.12
      Name: GlobalPlan
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Style: None
      Queue Size: 10
      Topic: /move_base/GlobalPlanner/plan
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 25; 255; 0
      Enabled: true
      Line Style: Billboards
      Line Width: 0.12
      Name: LocalPlan
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Style: None
      Queue Size: 10
      Topic: /teb_frontier/local_plan_safe
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/XYOrbit
      Distance: 24
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Near Clip Distance: 0.01
      Target Frame: map
      Value: XYOrbit (rviz)
      Pitch: 0.8
      Yaw: 1.2
    Saved: ~
Window Geometry:
  Height: 920
  Width: 1650
  X: 20
  Y: 20
